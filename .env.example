# --- 快报 LLM（OpenAI Python SDK 兼容网关；火山方舟 Coding + MiniMax 见下方 profile）---
# 方舟 OpenAI 兼容说明：https://www.volcengine.com/docs/82379/1330626
# Coding 网关 base 示例：https://ark.cn-beijing.volces.com/api/coding/v3 （与控制台一致即可）
OPENAI_PROVIDER_PROFILE=volcengine
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
OPENAI_MODEL=minimax-m2.7
# ark 一般用 chat completions；responses 多在专用托管上开放
OPENAI_WIRE_API=chat
#
# --- 可选：沿用其它 profile（会与上方 volcengine 默认互斥，显式 OPENAI_PROVIDER_PROFILE 生效）---
# OPENAI_PROVIDER_PROFILE=smartingredients
# OPENAI_BASE_URL=https://ai.smartingredients.my/v1
# OPENAI_WIRE_API=responses
#
# OPENAI_REASONING_EFFORT=
# OPENAI_PERSONALITY=pragmatic
# OPENAI_PROMPT_KEY=1
# OPENAI_RESPONSES_FALLBACK_CHAT=1
#
# 迁移兼容：若未配置 OPENAI_API_KEY，仍可回退读取 SMARTINGREDIENTS_API_KEY 或历史上的 ANTHROPIC_*。
# SMARTINGREDIENTS_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# --- 代理：若经代理访问 GitHub 出现 TLS EOF，可对 GitHub 直连（其它请求仍走 HTTP(S)_PROXY）---
# httpx / urllib 会读 NO_PROXY（小写 no_proxy 同理）；写进仓库根 .env 后由 load_settings() 加载。
NO_PROXY=api.github.com,github.com
no_proxy=api.github.com,github.com

# --- GitHub API（可选，提高限额；公开读取可不填）---
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# --- 小红书 / 第三方（MVP 占位：无公开 API，见 data/xiaohongshu_seed.json）---
XHS_SESSION_COOKIE=
XHS_API_BASE_URL=
XHS_API_KEY=

# --- RSS：逗号分隔；非空则完全覆盖默认 feed（量子位、GitHub Blog）---
# RSS_FEED_URLS=https://www.qbitai.com/feed,https://github.blog/feed/

# --- InfoQ：默认仅中文 feed；英文见 INFOQ_INCLUDE_EN 或自定义 INFOQ_FEED_URLS ---
# INFOQ_INCLUDE_EN=1
# INFOQ_FEED_URLS=https://www.infoq.cn/feed,https://www.infoq.com/rss/rss.action

# --- 机器之心：文章库 JSON API（非 RSS）---
# JIQIZHIXIN_API_BASE_URL=https://www.jiqizhixin.com
# JIQIZHIXIN_MAX_PAGES=8

DIGEST_STRICT_URLS=1
# 同时生成卡片式 HTML（output/digest-<周>.html）
DIGEST_OUTPUT_HTML=1
DIGEST_LLM_TEMPERATURE=0.35
# 主编结构化 JSON 的输出上限（过低易截断断引号）；网关若报 max_tokens 错误可调低
# DIGEST_LLM_MAX_COMPLETION_TOKENS=8192

# DIGEST_FETCH_BODY=0
# DIGEST_FETCH_MAX_ARTICLES=40
# DIGEST_FETCH_TIMEOUT_SEC=22
# DIGEST_FETCH_MAX_RESPONSE_BYTES=2000000
# DIGEST_BODY_MAX_CHARS=12000
# DIGEST_BODY_PROMPT_CHARS=6000

# DIGEST_CS_FILTER=1
# DIGEST_CS_MIN_SCORE=3
# DIGEST_CS_TOP_K=0

# PydanticAI 条目草稿打分（技术性/可信度等）；=1 时需 pip install -r requirements-agent.txt
# DIGEST_AGENT_SCORE=1
# DIGEST_AGENT_SCORE_MAX_ARTICLES=48
# DIGEST_AGENT_SCORE_BATCH_SIZE=18
# DIGEST_AGENT_SCORE_TEMPERATURE=0.15

DIGEST_TZ=Asia/Shanghai
